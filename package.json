{
  "name": "dsh-tool-web-enhanced",
  "version": "0.2.0-rc.6",
  "description": "Modular search tool for DeepSeek Harness: attach SearXNG, RAG and your own sections to the native web_search.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "searxng",
    "search",
    "plugin",
    "agent-tools",
    "cordis"
  ],
  "homepage": "https://github.com/edusrez/dsh-tool-web-enhanced#readme",
  "bugs": {
    "url": "https://github.com/edusrez/dsh-tool-web-enhanced/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edusrez/dsh-tool-web-enhanced.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "sqlite-vec": "^0.1.9"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.0-rc.7",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.6 || ^0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6 || ^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-web": "^0.1.0-rc.6 || ^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^20.19.43"
  }
}