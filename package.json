{
  "name": "dsh-tool-web-enhanced",
  "version": "0.1.0-rc.1",
  "description": "Drop-in enhancement of @deepseek-ai/dsh-tool-web: adds a `topic` vertical filter and an optional SearXNG result section to web_search, leaving web_fetch untouched.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.0-rc.7",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.6 || ^0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6 || ^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-web": "^0.1.0-rc.6 || ^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^20.19.43"
  }
}
